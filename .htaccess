# Culebro Abogados — Apache (GoDaddy cPanel). Cabeceras de seguridad + HTTPS.
# CSP ESTRICTA (hardening 1.5 hecho): sin 'unsafe-inline', sin CDNs.
# CSS/JS externos, fuentes e imágenes auto-hospedadas en /assets.

RewriteEngine On
# Forzar HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# Bloquear archivos sensibles
<FilesMatch "\.(md|sql|sample\.php|log|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|\.env)">
  Require all denied
</FilesMatch>
Options -Indexes
